# Copy this file to ".env" and fill it in. NEVER commit ".env" or put real keys in this example file.
# ---- FREE LLM: choose ONE provider ----
# Option A (easiest, free key, fast): groq     -> key from console.groq.com
# Option B (free key):                gemini   -> key from aistudio.google.com/apikey
# Option C (free, no key, runs on your PC): ollama (install from ollama.com, then: ollama pull llama3.1:8b)
# Option D: none -> offline rule-based mode (no LLM at all)
LLM_PROVIDER=none
LLM_API_KEY=
# Optional overrides (leave commented unless you get a 404 - free-tier model names change):
# LLM_MODEL=
# LLM_BASE_URL=

# Your real email: polite-pool access for Crossref / OpenAlex / Unpaywall (also used by the source recommender)
CONTACT_EMAIL=you@example.com
# SEMANTIC_SCHOLAR_API_KEY=
OUTDATED_YEARS=10
USE_EMBEDDINGS=false
