# CiteVerify Environment Variables

# AI Provider Configuration: "gemini" | "groq" | "offline"
LLM_PROVIDER=gemini

# Google Gemini API key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API key (Get free at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Generic fallback variables
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Optional Scholarly API Keys (APIs work without keys, keys increase rate limits)
SEMANTIC_SCHOLAR_API_KEY=
CONTACT_EMAIL=researcher@citeverify.org

# Database File Path
DB_PATH=citeverify.db
